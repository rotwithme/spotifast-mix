cask "spotifast-mix" do
  version "@VERSION@"
  sha256 "@MACOS_SHA256@"

  url "https://github.com/unconfigured/spotifast-mix/releases/download/v#{version}/spotifast-mix-v#{version}-macos-universal.dmg"
  name "Spotifast Mix"
  desc "Native Spotify and SoundCloud client"
  homepage "https://spotifast.rocks"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "Spotifast Mix.app"

  zap trash: [
    "~/Library/Application Support/app.spotifastmix.spotifast-mix",
    "~/Library/Caches/app.spotifastmix.spotifast-mix",
  ]
end
